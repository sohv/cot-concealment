# copy to .env and fill in the real values. .env is gitignored, this file is not.
# cp .env.example .env

# judge stage. openrouter exposes an openai compatible endpoint, so the openai sdk points at it
# unchanged. key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# mention detection is a narrow task, so the cheap tier is the default. overridden by --judge_model.
JUDGE_MODEL=openai/gpt-4.1-mini

# optional. openrouter attributes usage to these on its dashboard; blank is fine.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=cue-swap

# huggingface, for dataset rate limits when rebuilding the item pool. the datasets are public.
HF_TOKEN=hf_replace_me
